[Unit]
Description=Hello MicroDuck persistent camera calibration
After=network.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/hello-microduck/backend.py
Restart=on-failure
User=root
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/robot

[Install]
WantedBy=multi-user.target
